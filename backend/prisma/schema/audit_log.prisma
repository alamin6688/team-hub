model AuditLog {
  id          String   @id @default(cuid())
  action      String   // e.g., GOAL_CREATED, MEMBER_INVITED
  entityType  String
  entityId    String
  metadata    Json?
  actorId     String
  workspaceId String

  actor     User      @relation(fields: [actorId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
