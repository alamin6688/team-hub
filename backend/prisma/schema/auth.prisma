enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  MEMBER
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String
  avatarUrl       String?
  role            Role      @default(USER)
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())

  memberships   WorkspaceMember[]
  ownedGoals    Goal[]
  assignedItems ActionItem[]
  comments      Comment[]
  reactions     Reaction[]
  notifications Notification[]
  auditLogs     AuditLog[]
  otpTokens     OtpToken[]
  refreshTokens RefreshToken[]
}

model OtpToken {
  id        String     @id @default(uuid())
  userId    String
  otp       String
  purpose   OtpPurpose
  expiresAt DateTime
  used      Boolean    @default(false)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
